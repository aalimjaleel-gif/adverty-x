# ==============================================================================
# ADVERTY X — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# NOTICE: Use placeholder values only in this template.
# DO NOT COMMIT REAL CREDENTIALS, PRODUCTION SECRETS, OR PASSWORDS TO GIT.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER RUNTIME
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Adverty X"

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL / Neon / Supabase)
# ------------------------------------------------------------------------------
# PostgreSQL connection string:
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/adverty_x?schema=public"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SESSION SECURITY
# ------------------------------------------------------------------------------
# Minimum 32-character high-entropy secret string for signing session cookies
SESSION_SECRET="replace-with-a-secure-random-32-byte-hex-string-for-sessions"
# JWT / Token secret for password resets and email verification tokens
TOKEN_SECRET="replace-with-a-secure-random-32-byte-hex-string-for-tokens"

# ------------------------------------------------------------------------------
# 4. PAYMENT GATEWAY CONFIGURATION
# ------------------------------------------------------------------------------
# Gateway provider mode: "sandbox" | "stripe" | "jazzcash" | "easypaisa" | "paymob"
PAYMENT_GATEWAY_PROVIDER="sandbox"

# Stripe (When active)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_placeholder"
STRIPE_SECRET_KEY="sk_test_placeholder"
STRIPE_WEBHOOK_SECRET="whsec_placeholder"

# Local / Pakistan-Compatible Gateways (When configured)
JAZZ_CASH_MERCHANT_ID=""
JAZZ_CASH_PASSWORD=""
JAZZ_CASH_INTEGRITY_SALT=""
EASYPAISA_STORE_ID=""
EASYPAISA_HASH_KEY=""

# ------------------------------------------------------------------------------
# 5. PRIVATE VIDEO STREAMING & CLOUD STORAGE
# ------------------------------------------------------------------------------
# Provider: "signed-url" | "cloudflare-stream" | "vimeo" | "mux"
VIDEO_STORAGE_PROVIDER="signed-url"
VIDEO_STORAGE_SIGNING_SECRET="placeholder-video-signing-secret"
AWS_S3_BUCKET_NAME=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"

# ------------------------------------------------------------------------------
# 6. EMAIL & SYSTEM NOTIFICATIONS (Transactional SMTP)
# ------------------------------------------------------------------------------
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=587
SMTP_USER="smtp_user_placeholder"
SMTP_PASSWORD="smtp_password_placeholder"
SMTP_FROM_EMAIL="support@advertyx.com"
SMTP_FROM_NAME="Adverty X Support"

# ------------------------------------------------------------------------------
# 7. RATE LIMITING & SECURITY GUARDS
# ------------------------------------------------------------------------------
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_WINDOW_SECONDS=900
